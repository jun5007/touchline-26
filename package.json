{
  "name": "touchline-26",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "attributes:verify": "node -r ./scripts/register-typescript.cjs ./scripts/attributes.ts",
    "attributes:generate": "node -r ./scripts/register-typescript.cjs ./scripts/attributes.ts --write",
    "base-profile:scope": "node scripts/generate-p0-scope.mjs",
    "base-profile:docs": "node scripts/generate-base-profile-docs.mjs",
    "base-profile:generate": "node -r ./scripts/register-typescript.cjs ./scripts/generate-base-profiles.cjs",
    "base-profile:verify": "node scripts/verify-base-profile.mjs && vitest run src/lib/attributes/baseProfile.test.ts src/lib/attributes/buildGroupABaseProfiles.test.ts",
    "data:generate": "node scripts/generate-group-a.mjs",
    "data:validate": "node scripts/validate-data.mjs && node scripts/validate-sources.mjs",
    "data:coverage": "node scripts/generate-coverage-report.mjs",
    "data:future-leakage": "node scripts/validate-future-leakage.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "score-distribution:generate": "node -r ./scripts/register-typescript.cjs ./scripts/score-distributions.ts --write",
    "score-distribution:verify": "node -r ./scripts/register-typescript.cjs ./scripts/score-distributions.ts",
    "bundle:test": "node --test scripts/submission-bundle.node-test.mjs",
    "bundle:create": "node scripts/create-submission-bundle.mjs",
    "bundle:verify": "node scripts/verify-submission-bundle.mjs",
    "prebuild": "node -r ./scripts/register-typescript.cjs ./scripts/score-distributions.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.7"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
